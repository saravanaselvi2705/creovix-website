# Express CRM Backend Environment Variables

# Server Port
PORT=5000

# Database Connection (MongoDB Atlas connection string for production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/creovix_db?retryWrites=true&w=majority

# Security Secret key for JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL (Allowed CORS origin)
CLIENT_URL=http://localhost:3000

# Nodemailer SMTP settings (For sending email notifications to clients and admins)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
